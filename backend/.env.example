# Application
DEBUG=false
SECRET_KEY=change-me-in-production

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/design_pipeline

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
WATCH_FOLDER_PATH=./watch_folder

# AI Providers
DEFAULT_VISION_PROVIDER=openai
DEFAULT_EMBEDDING_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_VISION_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic (optional)
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_VISION_MODEL=claude-3-haiku-20240307

# fal.ai (optional, for LoRA training and image generation)
FAL_API_KEY=

# Clustering
CLUSTERING_METHOD=hdbscan
HDBSCAN_MIN_CLUSTER_SIZE=3
HDBSCAN_MIN_SAMPLES=2

# Payments (Lemon Squeezy) — leave blank for mock gateway
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_STORE_ID=

# Google OAuth (Sign in with Google) — leave blank to disable the Google button
GOOGLE_CLIENT_ID=

# Manual PayPal purchases (interim flow while LS approval is pending)
# e.g. https://paypal.me/yourname — leave blank to hide the PayPal option
PAYPAL_ME_URL=
# Mock gateway auto-credits sparks without payment — local dev only.
# Outside ENVIRONMENT=local it requires this explicit opt-in.
PAYMENTS_ALLOW_MOCK=false

# Welcome bonus granted to every new account (0 disables)
SIGNUP_BONUS_SPARKS=500
