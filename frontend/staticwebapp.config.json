{
  "routes": [
    { "route": "/clusters/*.txt", "rewrite": "/clusters/_.txt" },
    { "route": "/clusters/*", "rewrite": "/clusters/_.html" },
    { "route": "/images/folder/*.txt", "rewrite": "/images/folder/_.txt" },
    { "route": "/images/folder/*", "rewrite": "/images/folder/_.html" },
    { "route": "/models/*.txt", "rewrite": "/models/_/evaluations/_.txt" },
    { "route": "/models/*", "rewrite": "/models/_/evaluations/_.html" }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/_next/*", "/api/*"]
  }
}
