# Cloud DEV Connection Config
# Copy to .env.cloud and fill in values, or run: ./scripts/setup-cloud-env.sh
#
# This connects local processes (native or Docker) to Azure DEV resources.
# API keys are read from the root .env file — no need to duplicate them here.

# PostgreSQL (Azure Flexible Server)
DATABASE_URL=postgresql://imggenadmin:PASSWORD@psql-imggen-dev2.postgres.database.azure.com:5432/imggen?sslmode=require

# Redis (Azure Cache for Redis — TLS required, use rediss://)
REDIS_URL=rediss://:REDIS_KEY@redis-imggen-dev.redis.cache.windows.net:6380/0
CELERY_BROKER_URL=rediss://:REDIS_KEY@redis-imggen-dev.redis.cache.windows.net:6380/1
CELERY_RESULT_BACKEND=rediss://:REDIS_KEY@redis-imggen-dev.redis.cache.windows.net:6380/2

# Azure Blob Storage
STORAGE_BACKEND=azure
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=stimggendev;AccountKey=ACCOUNT_KEY;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=images

# Environment
ENVIRONMENT=dev
NEXT_PUBLIC_ENV_LABEL=cloud-native

# JWT (use the same secret as DEV cloud to share sessions)
JWT_SECRET_KEY=

# API keys (override root .env if needed, otherwise leave blank to use root .env values)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
FAL_API_KEY=
